# Environment Configuration for Smart Classroom Equipment Booking System
# Port configuration
PORT=3000
NODE_ENV=development

# JSON Web Token Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# MongoDB Atlas Connection URI (when running with standalone MongoDB cluster)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_classroom_db?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_classroom_db"

# GEMINI_API_KEY: Required for optional Gemini AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
